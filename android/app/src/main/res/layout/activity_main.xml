<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chỉ dùng cho thiết bị bạn sở hữu hoặc đã được chủ thiết bị đồng ý."
        android:textAlignment="center"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnHostMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_host_mode"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnControllerMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_controller_mode" />

</LinearLayout>
